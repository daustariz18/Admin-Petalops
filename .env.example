# Activa pruebas sin backend real para el flujo de subida (legacy)
VITE_USE_UPLOAD_MOCK=false

# Endpoint que devuelve el producto disponible para asignar automaticamente
VITE_AVAILABLE_PRODUCT_ENDPOINT=/api/productos/disponible

# Endpoint que reserva un producto disponible para evitar colisiones
VITE_RESERVE_PRODUCT_ENDPOINT=/api/productos/reservar-disponible

# URL base del backend real de Petalops
VITE_API_URL=https://catalogo-web-708265049038.us-central1.run.app

# Ruta opcional para intercambiar una sesion por cookie. Dejar vacia si el backend no la expone.
# VITE_ADMIN_PRODUCTOS_EXCHANGE_PATH=/auth/admin-productos/exchange

# Ruta base de productos en backend (ajustar si backend expone otro prefijo)
VITE_PRODUCTS_BASE_PATH=/admin/productos

# Fallback opcional cuando /categorias falla (JSON array en una sola línea)
# Ejemplo: [{"idCategoria":1,"nombre":"Ramos"},{"idCategoria":2,"nombre":"Orquideas"}]
VITE_FALLBACK_CATEGORIAS=
